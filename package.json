{
  "name": "meu-electron-app",
  "version": "0.6.0",
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "install-electron",
    "start": "node launch.js",
    "start:linux": "bash ./helper-node.sh --local",
    "setup-hotkeys": "bash ./setup-hotkey.sh",
    "fix-hotkeys": "rm -f $HOME/.config/helper-node/.setup-done && HELPER_NODE_FORCE_HOTKEY_SETUP=1 bash ./setup-hotkey.sh",
    "icon:win": "node ./scripts/generate-windows-icon.js",
    "check": "node ./scripts/check.js",
    "test:stream": "node ./scripts/test-backend-stream.js",
    "test:stt": "node ./scripts/test-realtime-stt.js",
    "test:ide": "node ./scripts/test-ide-mode.js",
    "hooks:install": "git config core.hooksPath scripts/githooks",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:url": "node ./scripts/test-backend-url.js",
    "test:noclose": "node ./scripts/test-backend-noclose.js",
    "test:ollama": "node ./scripts/test-ollama-local.js",
    "test:ollama:ide": "node ./scripts/test-ollama-stream.js",
    "test:terminal": "node ./scripts/test-terminal.js",
    "test:paste": "node ./scripts/test-paste-image.js",
    "test:tree": "node ./scripts/test-tree-editor.js",
    "test:javadeps": "node ./scripts/test-java-deps.js",
    "test:killtree": "node ./scripts/test-kill-tree.js",
    "test:copilotstop": "node ./scripts/test-copilot-stop.js",
    "test:stopnoerror": "node ./scripts/test-stop-no-error.js",
    "probe:copilot-models": "node ./scripts/probe-copilot-models.js",
    "test:scroll": "node ./scripts/test-scroll-latest.js",
    "test:tabscroll": "node ./scripts/test-tab-scroll.js",
    "test:terminalpaste": "node ./scripts/test-terminal-paste.js",
    "test:tabsync": "node ./scripts/test-realtime-tab-sync.js",
    "test:copilotlarge": "node ./scripts/test-copilot-large-object.js",
    "test:terminalspace": "node ./scripts/test-terminal-space.js",
    "test:history": "node ./scripts/test-history-formatter.js"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.9.0",
    "electron": "^43.3.0",
    "express": "^5.1.0",
    "form-data": "^4.0.5",
    "lottie-web": "^5.12.2",
    "node-fetch": "^3.3.2",
    "sharp": "^0.34.2",
    "tesseract.js": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
